<Window x:Class="WpfCctvMonitorApp.LoadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WpfCctvMonitorApp"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="LoadingWindow" 
        AllowsTransparency="True"
        Background="#00000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Height="300" Width="350">

    <Grid Background="Transparent">
        <StackPanel Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing Width="200" Height="200" IsIndeterminate="True" Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
            <TextBlock Text="CCTV 목록을 불러오는 중..."
               Margin="0,20,0,0"
               FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="White" Background="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
        </StackPanel>
    </Grid>

</Window>

