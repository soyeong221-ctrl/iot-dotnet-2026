<mah:MetroWindow x:Class="WpfBusanFoodApp.FoodDetailWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="맛집 상세정보"
                 Height="720"
                 Width="760"
                 WindowStartupLocation="CenterOwner">

    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <iconPacks:PackIconMaterial Kind="MapMarkerRadius"
                                    Foreground="White"
                                    Margin="10,7,0,0"/>
            
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <!-- 내용이 길어질 수 있으므로 ScrollViewer를 사용. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <!-- 상세정보 전체 영역. -->
        <StackPanel Margin="20">

            <!-- 대표 이미지 영역. -->
            <Border Height="300"
        Background="#EAEAEA"
        CornerRadius="6"
        ClipToBounds="True"
        Margin="0,0,0,16">
                <Image Source="{Binding MainImgNormal}"
           Stretch="UniformToFill"/>
            </Border>

            <!-- 맛집 이름 -->
            <TextBlock Text="{Binding MainTitle}"
                       FontSize="26"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,20,0,10"/>

            <Separator Margin="0,0,0,15"/>

            <!-- 구군 -->
            <TextBlock Text="구군"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding GugunNm}"
                       Margin="0,0,0,12"/>

            <!-- 주소 -->
            <TextBlock Text="주소"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding Addr1}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- 상세 주소 -->
            <TextBlock Text="상세 주소"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding Addr2}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- 지도 제목 -->
            <TextBlock Text="위치"
                       FontWeight="Bold"/>

            <!-- CefSharp 웹브라우저 컨트롤 - HTML 지도 코드 표시. -->
            <cefSharp:ChromiumWebBrowser x:Name="MapBrowser"
                                         Height="250"
                                         Background="White"
                                         Margin="0,0,0,12"/>

            <!-- 대표 메뉴 -->
            <TextBlock Text="대표 메뉴"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding RepresentativeMenu}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <!-- 전화번호 -->
            <TextBlock Text="전화번호"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding CntctTel}"
                       Margin="0,0,0,12"/>
            
            <!-- 홈페이지 -->
            <TextBlock Text="홈페이지"
                       FontWeight="Bold"/>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,0,0,12">   
                <Hyperlink Click="Homepage_Click">
                    <Run Text="{Binding HomepageUrl, TargetNullValue='등록된 홈페이지가 없습니다.', FallbackValue='등록된 홈페이지가 없습니다.'}"/>
                </Hyperlink>
            </TextBlock>

            <!-- 상세 설명 제목 -->
            <TextBlock Text="상세 설명"
                       FontWeight="Bold"
                       FontSize="18"
                       Margin="0,15,0,8"/>

            <!-- 상세 설명 출력 영역.
                 API 설명에 HTML 태그가 섞여 있을 수 있어서 제거한 뒤 여기에 넣을 예정. -->
            <TextBlock x:Name="TxtItemContents"
                       TextWrapping="Wrap"
                       LineHeight="24"
                       Margin="0,0,0,20"/>

        </StackPanel>
    </ScrollViewer>
</mah:MetroWindow>