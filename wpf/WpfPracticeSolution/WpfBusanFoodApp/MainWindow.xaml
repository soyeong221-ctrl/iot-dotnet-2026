<mah:MetroWindow x:Class="WpfBusanFoodApp.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="부산 맛집정보"
                 Height="600"
                 Width="1000"
                 WindowStartupLocation="CenterScreen"
                 Loaded="MetroWindow_Loaded">

    <mah:MetroWindow.IconTemplate>
        <DataTemplate>
            <iconPacks:PackIconMaterial Kind="FoodForkDrink"
                                        Foreground="White"
                                        Margin="10,7,0,0"/>
        </DataTemplate>
    </mah:MetroWindow.IconTemplate>

    <DockPanel Background="#F7F7F7">

        <!-- 데이터 로드 성공/실패 메시지 -->
        <StatusBar DockPanel.Dock="Bottom"
                   Height="30"
                   Foreground="White">
            <StatusBarItem>
                <TextBlock Text="데이터포털 부산맛집정보 API 활용 앱"/>
            </StatusBarItem>

            <Separator Background="White"/>

            <StatusBarItem>
                <TextBlock x:Name="SbiStatus"
                           Text="준비"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 제목 -->
            <TextBlock Grid.Row="0"
                       Text="부산 맛집정보"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#222222"
                       Margin="0,0,0,12"/>

            <!-- 검색 -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,10">
                
                <!-- 랜덤 추천 버튼 -->
                <Button x:Name="BtnRandom"
                        Width="125"
                        Height="36"
                        Margin="0,0,16,0"
                        Click="BtnRandom_Click">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <iconPacks:PackIconMaterial Kind="SilverwareForkKnife"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,5,0"/>

                        <TextBlock Text="오늘 뭐 먹지?" FontSize="12" />
                    </StackPanel>
                </Button>
                
                <TextBlock Text="페이지번호"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,8,0"/>

                <mah:NumericUpDown x:Name="NumPageNo"
                                   Width="80"
                                   Height="36"
                                   Minimum="1"
                                   Value="1"
                                   Margin="0,0,12,0"/>

                <TextBlock Text="결과수"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,8,0"/>

                <mah:NumericUpDown x:Name="NumOfRows"
                                   Width="80"
                                   Height="36"
                                   Minimum="1"
                                   Maximum="100"
                                   Value="10"
                                   Margin="0,0,12,0"/>

                <!-- 검색 버튼 -->
                <Button x:Name="BtnSearch"
                        Width="90"
                        Height="36"
                        Foreground="White"
                        FontWeight="Bold"
                        Style="{StaticResource MahApps.Styles.Button.Dialogs.Accent}"
                        Click="BtnSearch_Click">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <iconPacks:PackIconMaterial Kind="Magnify"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,5,0"/>

                        <TextBlock Text="검색"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 맛집 목록 표 -->
            <DataGrid Grid.Row="2"
                      x:Name="DgrFood"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowHeaderWidth="0"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="{StaticResource GridAltBrush}"
                      BorderBrush="{StaticResource GridLineBrush}"
                      BorderThickness="1"
                      MouseDoubleClick="DgrFood_MouseDoubleClick">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource GridHoverBrush}"/>
                            </Trigger>

                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="순번"
                                        Binding="{Binding DisplayNo}"
                                        Width="60"/>

                    <DataGridTemplateColumn Header="이미지"
                                            Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding MainImgThumb}"
                                       Width="60"
                                       Height="45"
                                       Stretch="UniformToFill"
                                       Margin="4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="맛집명"
                                        Binding="{Binding MainTitle}"
                                        Width="180"/>

                    <DataGridTextColumn Header="구군"
                                        Binding="{Binding GugunNm}"
                                        Width="90"/>

                    <DataGridTextColumn Header="주소"
                                        Binding="{Binding Addr1}"
                                        Width="*"/>

                    <DataGridTextColumn Header="대표메뉴"
                                        Binding="{Binding RepresentativeMenu}"
                                        Width="170"/>

                    <DataGridTextColumn Header="전화번호"
                                        Binding="{Binding CntctTel}"
                                        Width="130"/>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>