<Window x:Class="WpfAccessControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfAccessControlApp"
        mc:Ignorable="d"
        Title="스마트 출입 통제 관제 시스템"
        Height="650"
        Width="1150"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}" Icon="/access-control-app-preview.png">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.2*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <materialDesign:Card Grid.Row="0"
                                     Margin="0,0,0,10"
                                     Padding="8"
                                     UniformCornerRadius="8">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,0,0,12">
                            <materialDesign:PackIcon Kind="ShieldAccount" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text=" 보안 구역 등록 사원 명단" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>

                        <DataGrid x:Name="GrdUsers"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  MouseDoubleClick="GrdUsers_MouseDoubleClick">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="사원번호"
                                                    Binding="{Binding user_idx}"
                                                    Width="70" />

                                <DataGridTextColumn Header="이름"
                                                    Binding="{Binding user_name}"
                                                    Width="90" />

                                <DataGridTextColumn Header="부서명"
                                                    Binding="{Binding dept_name}"
                                                    Width="110" />

                                <DataGridTextColumn Header="전화번호"
                                                    Binding="{Binding user_phone}"
                                                    Width="130" />

                                <DataGridTextColumn Header="카드 UID"
                                                    Binding="{Binding card_uid}"
                                                    Width="110" />

                                <DataGridTextColumn Header="출입 등급"
                                                    Binding="{Binding auth_level}"
                                                    Width="80" />

                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Grid.Row="1"
                                     Margin="0,10,0,0"
                                     Padding="8"
                                     UniformCornerRadius="8"
                                     Background="{DynamicResource MaterialDesignBackground}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="실시간 시스템 출입 로그"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="5,0,0,8"
                                   Foreground="{DynamicResource MaterialDesignBody}" />

                        <DataGrid x:Name="GrdAccessLogs"
          Grid.Row="1"
          AutoGenerateColumns="False"
          IsReadOnly="True">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding access_result}" Value="실패">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding access_result}" Value="성공">
                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="로그번호"
                                                    Binding="{Binding log_idx}"
                                                    Width="80" />

                                <DataGridTextColumn Header="사원번호"
                                                    Binding="{Binding user_idx}"
                                                    Width="80" />

                                <DataGridTextColumn Header="사원이름"
                                                    Binding="{Binding user_name}"
                                                    Width="100" />

                                <DataGridTextColumn Header="부서명"
                                                    Binding="{Binding dept_name}"
                                                    Width="110" />

                                <DataGridTextColumn Header="출입시간"
                                                    Binding="{Binding access_time, StringFormat='yyyy-MM-dd HH:mm:ss'}"
                                                    Width="160" />

                                <DataGridTextColumn Header="인증 결과"
                                                    Binding="{Binding access_result}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <materialDesign:Card Grid.Column="1"
                                 Margin="10"
                                 Padding="15"
                                 UniformCornerRadius="8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="사원 상세 정보 관리"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Top">

                        <TextBox x:Name="TxtUserIdx"
                                 IsReadOnly="True"
                                 Margin="0,8"
                                 materialDesign:HintAssist.Hint="사원 고유 번호 (자동 생성)"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="KeyChain"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox x:Name="TxtUserName"
                                 Margin="0,8"
                                 materialDesign:HintAssist.Hint="사원 이름 (필수)"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Account"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <ComboBox x:Name="CboDeptCode"
                                  Margin="0,8"
                                  SelectedValuePath="dept_code"
                                  DisplayMemberPath="dept_name"
                                  materialDesign:HintAssist.Hint="소속 부서 선택 (필수)"
                                  materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                  materialDesign:TextFieldAssist.LeadingIcon="Domain"
                                  Style="{StaticResource MaterialDesignFloatingHintComboBox}" />

                        <TextBox x:Name="TxtUserPhone"
                                 MaxLength="20"
                                 Margin="0,8"
                                 materialDesign:HintAssist.Hint="전화번호"
                                 materialDesign:HintAssist.HelperText="예: 010-1234-5678"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Phone"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox x:Name="TxtCardUid"
                                 MaxLength="30"
                                 Margin="0,8"
                                 materialDesign:HintAssist.Hint="카드 UID / 인증키 (필수)"
         
                                 materialDesign:HintAssist.HelperText="숫자 4자리를 입력하거나 카드를 태그하세요."
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="CreditCardOutline"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <TextBox x:Name="TxtAuthLevel"
                                 Text="1"
                                 Margin="0,8"
                                 materialDesign:HintAssist.Hint="출입 권한 등급 (필수)"
                                 materialDesign:HintAssist.HelperText="1(일반), 2(중간), 3(최고 보안 관리자)"
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="ShieldAlert"
                                 Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

                        <UniformGrid Columns="3" Margin="0,25,0,0">
                            <Button x:Name="BtnNew" 
                                    Margin="4" 
                                    Click="BtnNew_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="신규" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnSave" 
                                    Margin="4" 
                                    Click="BtnSave_Click"
                                    Style="{StaticResource MaterialDesignRaisedButton}">        
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="저장" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnDelete" 
                                    Margin="4" 
                                    Click="BtnDelete_Click"
                                    Background="#E53935" 
                                    BorderBrush="Transparent" 
                                    Foreground="White">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TrashCan" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="삭제" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <StatusBar Grid.Row="1" Background="{DynamicResource MaterialDesignDivider}">
            <StatusBarItem Margin="5,0" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldCheck" Foreground="#2E7D32" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="인프라 보안 시스템 가동 중" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <Separator />

            <StatusBarItem x:Name="SbiResMsg" Foreground="#2E7D32" FontWeight="Bold">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MonitorEye" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="시스템 모니터링을 시작합니다." VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>